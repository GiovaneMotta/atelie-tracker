# =====================================================================
# .env.example — CRM Ateliê da Lili
# Copie para ".env" (que NUNCA vai para o git) e preencha.
# No Netlify, cadastre estas variáveis em Site settings > Environment.
# NENHUMA credencial real deve viver no frontend (web/). Só o backend
# (netlify/functions) enxerga os segredos abaixo.
# =====================================================================

# ---------------------------------------------------------------------
# SUPABASE
# ---------------------------------------------------------------------
# URL do projeto e a ANON KEY são públicas (usadas pelo app React).
# Prefixo VITE_ = exposto ao frontend (por isso: SÓ chaves públicas aqui).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...ANON...

# SERVICE ROLE = chave de administrador do banco. SÓ no backend.
# Nunca prefixar com VITE_. Nunca commitar. Ignora RLS — usar com cuidado.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...SERVICE_ROLE...

# ---------------------------------------------------------------------
# WHATSAPP — WaScript / WaSpeed  (ref: api-whatsapp.wascript.com.br/api-docs)
# ---------------------------------------------------------------------
WASCRIPT_TOKEN=
WASCRIPT_BASE_URL=https://api-whatsapp.wascript.com.br
# Segredo compartilhado para validar o webhook de entrada de mensagens.
# Se a conta/API oferecer webhook, configure a URL no painel do WaScript:
#   https://SEU-SITE-CRM.netlify.app/webhooks/wascript
WASCRIPT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# FRENET — Expedição (cotação, etiqueta OneClick, rastreio)  [Fases 6/7]
# Doc oficial: https://docs.frenet.com.br/
# SEGREDOS (tokens) SÓ AQUI/NO NETLIFY. Nunca no banco, frontend, logs.
# ---------------------------------------------------------------------
# Token do Cliente (todas as chamadas). Token do Parceiro (WhiteLabel:
# cotação de postagem, etiqueta, saldo, cancelamento). O Partner Token é
# entregue pela Frenet após o processo de onboarding/homologação.
FRENET_API_TOKEN=
FRENET_PARTNER_TOKEN=

# Ambiente ativo: "homologacao" | "producao". Também editável na tela de
# Configurações (não-secreto). Em homologação o app mostra faixa de aviso.
FRENET_ENV=homologacao

# Base URLs por ambiente (deixe configurável — NÃO misture hml e produção).
#   • Cotação/rastreio "simples" (Correios etc.): api.frenet.com.br
#   • WhiteLabel (postagem/etiqueta/carteira): whitelabel.frenet.com.br/v1
#     Homologação WhiteLabel: whitelabel-hml.frenet.dev/v1 (confirme com a Frenet)
FRENET_BASE_URL=https://api.frenet.com.br
FRENET_WHITELABEL_BASE_URL=https://whitelabel.frenet.com.br/v1
FRENET_WHITELABEL_BASE_URL_HML=https://whitelabel-hml.frenet.dev/v1

# CEP de origem (também editável em Configurações). Só dígitos.
FRENET_CEP_ORIGEM=

# Caixa padrão (cm/kg) quando o produto não define dimensões:
FRETE_ALTURA=10
FRETE_LARGURA=25
FRETE_COMPRIMENTO=30
FRETE_PESO=0.5

# Webhook de rastreio (Frenet -> nós). Registre no painel Frenet a URL:
#   https://SEU-SITE-CRM.netlify.app/webhooks/frenet-tracking
# A Frenet permite um par nome/valor de header para segurança. Configure o
# MESMO par aqui e no painel. Se vazio, o webhook aceita sem validar (só use
# assim em homologação).
FRENET_WEBHOOK_TOKEN_NAME=x-frenet-webhook-token
FRENET_WEBHOOK_TOKEN_VALUE=

# ---------------------------------------------------------------------
# IA (provedor trocável — default Anthropic). SÓ no backend.
# ---------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
# (Opcional) outro provedor no futuro:
# OPENAI_API_KEY=

# ---------------------------------------------------------------------
# PAGAMENTO — InfinitePay (reaproveitado do catálogo)
# ---------------------------------------------------------------------
INFINITEPAY_HANDLE=
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------
SITE_URL=https://SEU-SITE-CRM.netlify.app
# Origens permitidas para CORS na API (separe por vírgula):
ALLOWED_ORIGINS=https://SEU-SITE-CRM.netlify.app,http://localhost:5173
